---
import Layout from '../../layouts/Layout.astro';
import BlogPostsList from '../../components/BlogPostsList.astro'

export async function getStaticPaths() {
	const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true }));

	return [
		{params: {tag: "projects"}, props: {posts: allPosts}},
		{params: {tag: "leetcode"}, props: {posts: allPosts}},
	];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const filteredPosts = posts.filter((post: any) => post.frontmatter.tags?.includes(tag));
const sortedPosts = filteredPosts.sort((a: any, b: any) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
---

<Layout pageTitle={tag}>
    <BlogPostsList posts={sortedPosts}/>
</Layout>