---
const { posts } = Astro.props;
---

{posts.map((post: any) => 
    <a href={post.url} class="block">
        <div class="p-4 flex justify-between items-center hover:bg-teal-950 transition-colors ease-in-out duration-300">
            <div>
                <h3>{post.frontmatter.title}</h3>
                <p class="text-sm text-teal-700">{post.frontmatter.pubDate}</p>
            </div>
            <p class="text-sm text-teal-700">➜</p>
        </div>
    </a>
    )}