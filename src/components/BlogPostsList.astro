---
const { posts } = Astro.props;
---

{posts.map((post: any) => 
    <a href={post.url} class="block">
        <div class="p-3 flex justify-between items-center hover:bg-yellow-800/20 transition-colors ease-in-out duration-300">
            <div>
                <h3>{post.frontmatter.title}</h3>
                <p class="text-sm text-orange-300/70">{post.frontmatter.pubDate}</p>
            </div>
            <p class="text-md text-orange-300/70">➜</p>
        </div>
    </a>
    )}