---
import Tags from '../components/Tags.astro';
const { posts } = Astro.props;
---

<h2 class="text-2xl text-white my-6">projects</h2>
<div class="grid gap-6 sm:grid-cols-1 lg:grid-cols-2 ">
  {posts.map((post) => (
	<a href={post.url} class="group block">
		<div class="h-full border border-stone-700/20 overflow-hidden hover:border-amber-500/30 transition-all duration-300">
			<div class="flex gap-4 p-5 justify-between overflow-hidden">
				<div class="flex flex-col gap-4 overflow-hidden">
					<h3 class="text-md text-white group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all">
						{post.frontmatter.title}
					</h3>
					<p class="text-sm">{post.frontmatter.description}</p>
					<Tags tags = {post.frontmatter.tags}/>
				</div>
				<span class="text-white-700 text-l group-hover:translate-x-0.5 group-hover:text-amber-400 transition-all duration-300">
				➔
				</span>
			</div>
		</div>
	</a>
  ))}
</div>