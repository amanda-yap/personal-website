---
const { posts } = Astro.props;
---

<div class="flex flex-col">
  {posts.map((post: any) => (
	<a href={post.url} class="lg:w-3/4 w-full">
		<div class="h-full transition-all duration-300">
			<div class="flex p-4 justify-between hover:bg-lime-800/10 transition-color duration-300">
				<h3 class="text-md">
					{post.frontmatter.title}
				</h3>
				<span class="text-lg">
				➔
				</span>
			</div>
		</div>
	</a>
  ))}
</div>