---
const { posts } = Astro.props;
const sortedPosts = posts.sort((a: any, b: any) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
const fmtDate = (d: string) =>
	new Date(d).toLocaleDateString("en-NZ", { month: "short", year: "numeric" }).toLowerCase();
---

<div class="flex flex-col border-t border-line">
  {sortedPosts.map((post: any) => (
	<a href={post.url} class="group border-b border-line">
		<div class="flex items-baseline gap-4 py-4">
			<h3 class="flex-1 group-hover:text-accent transition-colors duration-300">
				{post.frontmatter.title}
			</h3>
			{post.frontmatter.date && (
				<span class="hidden sm:inline text-sm text-muted">{fmtDate(post.frontmatter.date)}</span>
			)}
			<span class="text-lg group-hover:translate-x-1 transition-transform duration-300">
				→
			</span>
		</div>
	</a>
  ))}
</div>
