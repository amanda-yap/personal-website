---
const experiences = [
    {
        role: "pianist",
        company: "Freelance",
        dates: "2019 - Present",
        description:
        "Providing piano accompaniment for national choral competitions, examinations, concerts, and weddings.",
    },
    {
        role: "software engineer intern",
        company: "Serato",
        dates: "Nov 2024 - Feb 2025",
        description:
        "Worked directly in a development team on user-facing features for Hex FX and Serato Studio, using C++ and QML.",
    }
];
---
<div class="relative border-l-2 border-stone-700/20">
    {experiences.map((exp) => (
        <div class="ml-6 mb-10 relative">
            <span class="absolute -left-7.75 top-2.5 w-3 h-3 rounded-full bg-amber-950/90"></span>
            <div class="space-y-2">
                <div class="flex flex-col justify-between sm:flex-row gap-1">
                    <h3 class="text-xl font-medium">
                        {exp.role}
                    </h3>
                    <span class="text-md text-stone-500 italic">
                        {exp.dates}
                    </span>
                </div>

                <p class="text-md text-stone-500">
                    {exp.company}
                </p>

                <p class="text-md">
                    {exp.description}
                </p>
            </div>
        </div>
    ))}
</div>

