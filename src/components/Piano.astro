---
// layout config
const layout = {
    startX: 40,
    whiteWidth: 38,
    whiteHeight: 80,
    whiteY: 70,
    gap: 2,
    blackWidth: 20,
    blackHeight: 50,
    blackX: [70, 110, 190, 230, 270],
    blackY: 68
};

// notes
const whiteNotes = ["C4", "D4", "E4", "F4", "G4", "A4", "B4"];
const whiteKeys = ["a", "s", "d", "f", "g", "h", "j"];
const blackNotes = ["C#4", "D#4", "F#4", "G#4", "A#4"];
const blackKeys = ["w", "e", "t", "y", "u"];
---

<div class="piano relative w-full">
    <svg viewBox="0 36 360 136" xmlns="http://www.w3.org/2000/svg" class="w-full overflow-visible">
        <!-- body -->
        <rect x="20" y="40" rx="6" width="320" height="130" class="piano-body"/>

        <!-- gap between white keys -->
        <rect
            x={layout.startX}
            y={layout.whiteY}
            width={(layout.whiteWidth + layout.gap) * 7 - layout.gap}
            height={layout.whiteHeight}
            class="piano-gap"
        />

        <!-- white keys -->
        <g>
            {whiteNotes.map((note, i) => (
                <rect
                    x={layout.startX + i * (layout.whiteWidth + layout.gap)}
                    y={layout.whiteY}
                    rx="2"
                    width={layout.whiteWidth}
                    height={layout.whiteHeight}
                    data-note={note}
                    data-key={whiteKeys[i]}
                    class="white-key cursor-pointer"
                />
            ))}
        </g>

        <!-- black keys -->
        <g>
            {blackNotes.map((note, i) => (
                <rect
                    x={layout.blackX[i]}
                    y={layout.blackY}
                    rx="2"
                    width={layout.blackWidth}
                    height={layout.blackHeight}
                    data-note={note}
                    data-key={blackKeys[i]}
                    class="black-key cursor-pointer"
                />
            ))}
        </g>
    </svg>
</div>

<style>
    .piano-body {
        fill: var(--piano-body);
        stroke: var(--piano-rim);
        stroke-width: 1.6;
    }
    .piano-gap {
        fill: var(--piano-gap);
    }
    .white-key {
        fill: var(--piano-white);
        transition: fill 250ms ease;
    }
    .black-key {
        fill: var(--piano-black);
        transition: fill 250ms ease;
    }
    @media (hover: hover) {
        .white-key:hover {
            fill: color-mix(in srgb, var(--piano-white) 92%, var(--muted));
        }
        .black-key:hover {
            fill: color-mix(in srgb, var(--piano-black) 90%, var(--ink));
        }
    }
    .white-key.pressed {
        fill: color-mix(in srgb, var(--piano-white) 75%, var(--muted));
        transition: none;
    }
    .black-key.pressed {
        fill: color-mix(in srgb, var(--piano-black) 80%, var(--ink));
        transition: none;
    }
</style>

<script>
    const keys = document.querySelectorAll<SVGRectElement>('.white-key, .black-key');

    const notes: Record<string, number> = {
        'C4': 261.63,
        'C#4': 277.18,
        'D4': 293.66,
        'D#4': 311.13,
        'E4': 329.63,
        'F4': 349.23,
        'F#4': 369.99,
        'G4': 392.00,
        'G#4': 415.30,
        'A4': 440.00,
        'A#4': 466.16,
        'B4': 493.88
    };

    const audioContext = new AudioContext();

    function playTone(frequency: number, duration = 1) {
        if (!audioContext) {
            return;
        }
        // safari starts the context suspended until a user gesture
        if (audioContext.state === 'suspended') {
            audioContext.resume();
        }
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);

        oscillator.type = 'sine';
        oscillator.frequency.value = frequency;

        gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + duration);

        oscillator.start();
        oscillator.stop(audioContext.currentTime + duration);
    }

    function press(key: SVGRectElement) {
        const note = key.dataset.note;
        if (!note) return;
        playTone(notes[note]);
        key.classList.add('pressed');
        setTimeout(() => key.classList.remove('pressed'), 150);
    }

    keys.forEach(key => key.addEventListener('click', () => press(key)));

    // play with computer keys
    const byKey = new Map([...keys].map(k => [k.dataset.key, k]));
    document.addEventListener('keydown', (e) => {
        if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
        const key = byKey.get(e.key.toLowerCase());
        if (key) press(key);
    });
</script>
