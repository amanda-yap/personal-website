---
// layout config
const layout = {
    startX: 40,
    whiteWidth: 38,
    whiteHeight: 80,
    whiteY: 80,
    gap: 2,
    blackWidth: 20,
    blackHeight: 50,
    blackX: [70, 110, 190, 230, 270],
    blackY: 78
};

// notes
const whiteNotes = ["C4", "D4", "E4", "F4", "G4", "A4", "B4"];
const blackNotes = ["C#4", "D#4", "F#4", "G#4", "A#4"]
---

<svg viewBox="0 0 360 220" xmlns="http://www.w3.org/2000/svg" class="lg:w-3/5">
    <!-- body -->
    <rect x="20" y="40" width="320" height="140" rx="18" fill="#B8C799"/>
    <rect x="20" y="40" width="320" height="20" rx="10" fill="#9BAA7C"/>

    <!-- white keys when clicked + gap between white keys -->
    <rect
        x={layout.startX}
        y={layout.whiteY}
        width={(layout.whiteWidth + layout.gap) * 7 - layout.gap}
        height={layout.whiteHeight}
        fill="#C3C9C4"
    />

    <!-- white keys -->
    <g fill="#F3F3ED">
        {whiteNotes.map((note, i) => (
        <rect
            x={layout.startX + i * (layout.whiteWidth + layout.gap)}
            y={layout.whiteY}
            width={layout.whiteWidth}
            height={layout.whiteHeight}
            data-note={note}
            class="white-key cursor-pointer"
        />
        ))}
    </g>

    <!-- black keys when clicked -->
    <g fill="#1F3327">
        {blackNotes.map((note, i) => (
        <rect
            x={layout.blackX[i]}
            y={layout.blackY}
            width={layout.blackWidth}
            height={layout.blackHeight}
            rx="3"
            class="black-key cursor-pointer"
        />
        ))}
    </g>

    <!-- black keys -->
    <g fill="#596849">
        {blackNotes.map((note, i) => (
        <rect
            x={layout.blackX[i]}
            y={layout.blackY}
            width={layout.blackWidth}
            height={layout.blackHeight}
            data-note={note}
            rx="3"
            class="black-key cursor-pointer"
        />
        ))}
    </g>
</svg>


<script>
    const keys = document.querySelectorAll('.white-key, .black-key');

    const notes = {
        'C4': 261.63,
        'C#4': 277.18,
        'D4': 293.66,
        'D#4': 311.13,
        'E4': 329.63,
        'F4': 349.23,
        'F#4': 369.99,
        'G4': 392.00,
        'G#4': 415.30,
        'A4': 440.00,
        'A#4': 466.16,
        'B4': 493.88
    };

    const audioContext = new AudioContext();

    function playTone(frequency, duration = 1) {
        if (!audioContext) {
            return;
        }
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);

        oscillator.type = 'sine';
        oscillator.frequency.value = frequency;

        gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.3, audioContext.currentTime + 0.01);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 1);

        oscillator.start();
        oscillator.stop(audioContext.currentTime + duration);
    }

    keys.forEach(key => {
        key.addEventListener('click', () => {
        const note = key.getAttribute('data-note');
        if (note) {
            playTone(notes[note]);
            key.classList.add('opacity-80');
            setTimeout(() => key.classList.remove('opacity-80'), 150);
        }
        });
    });
</script>
