---
import { Github } from "lucide-astro";
const github = 'https://github.com/amanda-yap'; 
const { year = new Date().getFullYear() } = Astro.props;
---

<footer class="text-stone-400 pt-25">
  <div class="container mx-auto px-4 flex justify-between items-center">
    <p class="text-sm">&copy; {year} Amanda Yap.</p>
     <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <Github size={24} class="hover:scale-105 transition-transform duration-300"/>
    </a>
  </div>
</footer>