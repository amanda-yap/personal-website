---
import { Github } from "lucide-astro";
const github = 'https://github.com/amanda-yap'; 
const { year = new Date().getFullYear() } = Astro.props;
---

<footer class="mt-24 pt-6 border-t border-line text-sm text-muted">
  <div class="flex justify-between items-center gap-4">
    <p>&copy; {year} Amanda Yap.</p>
    <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-accent transition-colors duration-200">
      <Github size={20} />
    </a>
  </div>
</footer>

