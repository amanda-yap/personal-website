---
import { Book, Code, Music } from "lucide-astro";

const hobbies = [
  {
    name: "reading",
    icon: Book,
    current: "A Tale of Two Cities - Charles Dickens",
  },
  {
    name: "coding",
    icon: Code,
    current: "A microblog",
  },
  {
    name: "practising",
    icon: Music,
    current: "Schumann Piano Concerto, Mvt I",
  },
];
---

<h2 class="text-2xl mt-15 mb-6 text-white">
    currently
</h2>

<div class="flex flex-wrap gap-3">
    {hobbies.map((hobby) => {
        const Icon = hobby.icon;

        return (
        <div class="flex items-center gap-3 px-4 py-3 group border border-stone-700/20">
            <Icon class="w-5 text-amber-500/70 group-hover:text-amber-500 transition duration-300"/>
            <div class="flex flex-col">
                <span class="text-sm">{hobby.name}</span>
                <span class="text-xs text-stone-400">
                    {hobby.current}
                </span>
            </div>
        </div>
        );
    })}
</div>
