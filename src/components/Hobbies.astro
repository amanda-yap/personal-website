---
import { Book, Code, Music } from "lucide-astro";

const hobbies = [
  {
    name: "reading",
    icon: Book,
    current: "The Odyssey - Homer",
  },
  {
    name: "coding",
    icon: Code,
    current: "This website, with Astro and TailwindCSS",
  },
  {
    name: "practising",
    icon: Music,
    current: "Four Pieces for Piano, Op. 119 - Brahms",
  },
];
---

<div class="flex flex-wrap gap-3">
    {hobbies.map((hobby) => {
        const Icon = hobby.icon;

        return (
        <div class="flex items-center gap-3 px-4 py-3 group border border-stone-700/20 rounded-sm">
            <Icon class="w-5 text-lime-800/70 group-hover:text-lime-800 transition duration-300"/>
            <div class="flex flex-col">
                <span class="text-sm">{hobby.name}</span>
                <span class="text-xs text-stone-500">
                    {hobby.current}
                </span>
            </div>
        </div>
        );
    })}
</div>
