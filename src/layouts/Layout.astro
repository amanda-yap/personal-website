---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro'
const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Amanda Yap. Computer Science Student. Pianist.">
		<title>amanda yap</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
	</head>

	<body class="max-w-3xl mx-8 mt-20 lg:mx-auto">
		<main
			id="page"
			class="opacity-0 translate-y-2 transition-all duration-800 ease"
			>
			<a href="/"><img src="/logo.png" class="w-10 hover:scale-105 transition-transform duration-300"></a>
			<h1 class="text-4xl mt-3 mb-8 text-white">{pageTitle}</h1>
			<slot />
		</main>
		<Analytics />

		<script>
			window.addEventListener('load', () => {
			document.getElementById('page')
				?.classList.remove('opacity-0', 'translate-y-2')
			})
		</script>
	</body>
</html>
