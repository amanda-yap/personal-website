---
import "../styles/global.css";
import Navigation from '../components/Navigation.astro';
import Analytics from '@vercel/analytics/astro'
import Footer from '../components/Footer.astro';
const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Amanda Yap. Computer Science Student. Pianist.">
		<title>amanda yap</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
	</head>

	<body class="max-w-3xl mx-8 my-20 lg:mx-auto">
		<Navigation />
		<main
			id="page"
			class="opacity-0 translate-y-2 transition-all duration-800 ease"
			>
			<h1 class="text-3xl mt-8 mb-8 font-semibold">{pageTitle}</h1>
			<slot />
		</main>
		<Footer />
		<Analytics />

		<script>
			window.addEventListener('load', () => {
			document.getElementById('page')
				?.classList.remove('opacity-0', 'translate-y-2')
			})
		</script>
	</body>
</html>
